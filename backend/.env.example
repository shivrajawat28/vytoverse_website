# VytoVerse Backend Environment Variables
# Copy to .env and fill in values for your environment.
# NEVER commit the .env file.

# ── Database ──────────────────────────────────────────────────────────
# Local:  postgresql://postgres:postgres@localhost:5432/vytoverse
# Render: use the Internal Database URL from your Render PostgreSQL service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vytoverse

# ── JWT ───────────────────────────────────────────────────────────────
# Generate a strong random secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────
# The full URL of the deployed frontend (Netlify)
# Local dev:  http://localhost:5173
# Production: https://your-app.netlify.app
FRONTEND_URL=http://localhost:5173

# ── Backend URL ───────────────────────────────────────────────────────
# Local dev:  http://localhost:8000
# Production: https://your-app.onrender.com
BACKEND_URL=http://localhost:8000

# ── Server Port ───────────────────────────────────────────────────────
# Render sets this automatically. Local dev uses 8000.
PORT=8000

# ── Initial Admin Bootstrap (optional) ────────────────────────────────
# If set, this admin account is created/verified on startup.
# DO NOT commit real credentials. Set these in Render env vars only.
# INITIAL_ADMIN_EMAIL=vytoverse@admin.com
# INITIAL_ADMIN_PASSWORD=change-me-in-production

# ── Uploads ───────────────────────────────────────────────────────────
# Local storage directory (relative to backend working directory)
UPLOAD_DIR=uploads

# ── Storage Configuration ─────────────────────────────────────────────
# Set STORAGE_PROVIDER=supabase and configure Supabase Storage for persistent
# profile image storage on Render. Without these, uploads in local dev use the
# local filesystem (uploads/ directory).
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-share
SUPABASE_STORAGE_BUCKET=vytoverse-uploads

# Legacy / S3-compatible storage (optional fallback)
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=
